#define fail(...) do { \
  fputs("Error: ", stderr); \
  fprintf(stderr, __VA_ARGS__); \
  fputc('\n', stderr); \
  exit(EXIT_FAILURE); \
} while (0)

static void *alloc(size_t count, size_t size) {
  if (size && count > SIZE_MAX / size) fail("Allocation size overflow");
  void *memory = calloc(count ? count : 1, size);
